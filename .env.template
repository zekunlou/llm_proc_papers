# Zotero Configuration
# Get your library ID and API key from: https://www.zotero.org/settings/keys
ZOTERO_LIBRARY_ID=<your_library_id>
ZOTERO_LIBRARY_TYPE=user
ZOTERO_API_KEY=<your_zotero_api_key>

# Local Zotero data directory (where Zotero stores PDFs)
ZOTERO_DATA_DIR=~/Zotero

# LLM for OCR (OpenAI-compatible endpoint)
LLM_ENDPOINT=https://your-api-endpoint/v1
LLM_API_KEY=<your_llm_api_key>
LLM_OCR_MODEL=qwen3.6-35b-a3b

# PDF rendering resolution in DPI
LLM_OCR_DPI=200

# Image token budget (each token = 32×32 px patch)
LLM_OCR_MIN_TOKENS=10000
LLM_OCR_MAX_TOKENS=50000

# Max pages processed concurrently (tune to your API rate limit)
LLM_OCR_CONCURRENCY=4
